{
  "name": "share",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc -b",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:migrate:local": "wrangler d1 execute DB --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute DB --remote --file=./schema.sql",
    "deploy": "pnpm build && wrangler deploy",
    "e2e": "node e2e/run.mjs",
    "e2e:prod": "E2E_BASE_URL=https://share.huyab.click node e2e/readonly-smoke.mjs"
  },
  "dependencies": {
    "@huyab/sso": "github:nguyenhuy158/kit#v0.1.0&path:packages/sso",
    "@tailwindcss/vite": "^4.0.0",
    "hono": "^4.12.27",
    "lucide-react": "^1.31.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/workers-types": "^5.20260703.1",
    "@huyab/e2e": "github:nguyenhuy158/kit#v0.1.0&path:packages/e2e",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "wrangler": "^4.106.0"
  }
}
